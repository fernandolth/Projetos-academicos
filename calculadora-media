def calcular_media():

    print("=== Sistema de notas dos alunos.")
    n1 = float(input("digigte a primeira nota: "))
    n2 = float(input("digigte a segunda nota: "))
    media = (n1 + n2) / 2
    print("A média final é", media)
    if media >= 7:
        print("Status: Aprovado")
    else:
        print("Status: Reprovado")
calcular_media()
